SYSTEM_TEST_ENVIRONMENT=system-test
SYSTEM_TEST_CONFIRM_ISOLATED=gernetix-system-test-only

# Synthetic values for disposable local tests only. Never copy staging or production secrets.
SYSTEM_TEST_POSTGRES_PASSWORD=replace-with-a-synthetic-system-test-password
SYSTEM_TEST_FORGEJO_POSTGRES_PASSWORD=replace-with-a-different-synthetic-password
SYSTEM_TEST_FORGEJO_SECRET_KEY=replace-with-a-random-synthetic-secret-key
SYSTEM_TEST_FORGEJO_INTERNAL_TOKEN=replace-with-a-random-synthetic-internal-token
