# Lokaler Identity Server mit gemeinsamem VPS-Datenstand.
# Nach .env.remote-dev.local kopieren; die lokale Datei bleibt unversioniert.
IDENTITY_POSTGRES_PASSWORD=change-me
IDENTITY_POSTGRES_HOST=127.0.0.1
IDENTITY_POSTGRES_PORT=15432
IDENTITY_POSTGRES_DATABASE=gernetix_identity
IDENTITY_POSTGRES_USER=gernetix_identity

# Diese Ports werden durch tools/connect-staging.js bereitgestellt.
PROJECT_SERVER_BASE_URL=http://127.0.0.1:4800
BUILD_DEPLOY_BASE_URL=http://127.0.0.1:4400
DEVICE_MANAGEMENT_BASE_URL=http://127.0.0.1:4700
HARDWARE_SHOP_BASE_URL=http://127.0.0.1:4900
HARDWARE_CATALOG_BASE_URL=http://10.77.0.1:4910
AI_USAGE_BASE_URL=http://127.0.0.1:5001
AI_CONTEXT_BASE_URL=http://127.0.0.1:5500
COMMUNITY_PLATFORM_BASE_URL=http://127.0.0.1:5200
TELEMETRY_SERVER_BASE_URL=http://127.0.0.1:5600
