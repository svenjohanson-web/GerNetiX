GERNETIX_IMAGE_TAG=local
PRIVATE_VPS_BIND_ADDRESS=10.77.0.1
PRIVATE_DNS_PORT=53
PRIVATE_PLATFORM_TUNNEL_PORT=8080
ACME_HTTP_BIND_ADDRESS=0.0.0.0
ACME_HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
ADMIN_PORT=4600
MQTT_TLS_PORT=8883
MQTT_LETSENCRYPT_DIR=/etc/letsencrypt
DEVICE_CA_CERTIFICATE_PATH=/etc/gernetix/pki/device-ca.pem
DEVICE_CA_PRIVATE_KEY_PATH=/etc/gernetix/pki/device-ca-key.pem
OTA_SIGNING_PRIVATE_KEY_PATH=/etc/gernetix/pki/ota-signing-key.pem
OTA_SIGNING_PUBLIC_KEY_PATH=/etc/gernetix/pki/ota-signing-public.pem
OTA_SIGNING_KEY_ID=ota-p256-2026-01

# Optional: externer oder auf dem VPS erreichbarer Ollama-Endpunkt.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# E-Mail-Links und interne Admin-zu-Identity-Absicherung. Eigene, lange Zufallswerte einsetzen.
IDENTITY_APP_BASE_URL=https://pwa.gernetix.com
IDENTITY_PASSKEY_RP_ID=pwa.gernetix.com
IDENTITY_PASSKEY_ALLOWED_ORIGINS=https://pwa.gernetix.com
IDENTITY_ADMIN_TOKEN=replace-with-a-long-random-secret
# Getrennte Testprofile fuer die Funktionspruefung von Basis und Premium.
DEMO_USER=demo
DEMO_EMAIL=demo@gernetix.local
DEMO_PASSWORD=replace-with-a-premium-demo-password
BASIS_DEMO_USER=basis
BASIS_DEMO_EMAIL=basis@gernetix.local
BASIS_DEMO_PASSWORD=replace-with-a-basis-demo-password
# Oeffentlicher Ed25519-Trust-Ring. Er darf an interne Verifier verteilt werden;
# private Schluessel bleiben strikt beim jeweils ausstellenden Dienst.
INTERNAL_API_TRUSTED_PUBLIC_KEYS_JSON={"replace-with-kid":{"issuer":"replace-with-service","publicKeyB64":"replace-with-spki-der-base64"}}
IDENTITY_INTERNAL_API_SIGNING_KEY_ID=identity-server-replace-with-version
IDENTITY_INTERNAL_API_SIGNING_PRIVATE_KEY_B64=replace-with-pkcs8-der-base64
ADMIN_TOOL_INTERNAL_API_SIGNING_KEY_ID=admin-tool-replace-with-version
ADMIN_TOOL_INTERNAL_API_SIGNING_PRIVATE_KEY_B64=replace-with-pkcs8-der-base64
ADMIN_ACCESS_INTERNAL_API_SIGNING_KEY_ID=admin-access-server-replace-with-version
ADMIN_ACCESS_INTERNAL_API_SIGNING_PRIVATE_KEY_B64=replace-with-pkcs8-der-base64
BUILD_DEPLOY_INTERNAL_API_SIGNING_KEY_ID=build-deploy-server-replace-with-version
BUILD_DEPLOY_INTERNAL_API_SIGNING_PRIVATE_KEY_B64=replace-with-pkcs8-der-base64
TELEMETRY_INTERNAL_API_SIGNING_KEY_ID=telemetry-server-replace-with-version
TELEMETRY_INTERNAL_API_SIGNING_PRIVATE_KEY_B64=replace-with-pkcs8-der-base64
DEVICE_VOICE_INTERNAL_API_SIGNING_KEY_ID=device-voice-orchestrator-replace-with-version
DEVICE_VOICE_INTERNAL_API_SIGNING_PRIVATE_KEY_B64=replace-with-pkcs8-der-base64
EMAIL_CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PUBLIC_DEMO_PUBLISHER_TOKEN=replace-with-a-separate-long-random-secret
# Optionaler Empfaenger fuer den generischen E-Mail-Hinweis. Ohne Eintrag wird der
# Sicherheitsalarm-Empfaenger aus der SMTP-Konfiguration verwendet.
COMMUNITY_NOTIFICATION_EMAIL_RECIPIENT=
# Bleibt bis zur fachlich/rechtlich bestaetigten Fristentscheidung deaktiviert.
# Kandidaten: 30 Tage fuer erfolgreiche/uebersprungene Zustellungen und 90 Tage
# fuer Dead Letter beziehungsweise fehlgeschlagene Zustellnachweise.
COMMUNITY_NOTIFICATION_RETENTION_ENABLED=0
COMMUNITY_NOTIFICATION_DELIVERED_RETENTION_DAYS=30
COMMUNITY_NOTIFICATION_DEAD_LETTER_RETENTION_DAYS=90
# Ebenfalls bis zur Fristfreigabe deaktiviert. Kandidaten: abgelaufene
# Verifizierungs-/Reset-Tokens nach 7 Tagen, Support-Recovery nach 30 Tagen.
IDENTITY_TOKEN_RETENTION_ENABLED=0
IDENTITY_EXPIRED_TOKEN_RETENTION_DAYS=7
IDENTITY_SUPPORT_RECOVERY_RETENTION_DAYS=30
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Eine zentrale PostgreSQL-Laufzeitdatenbank fuer alle Domaenen.
RUNTIME_POSTGRES_PASSWORD=change-me-before-deploy
# Drei getrennte, lange Zufallswerte fuer den internen Forgejo-Dienst. Das
# Datenbankpasswort, der dauerhafte Verschluesselungsschluessel und das interne
# Signaturtoken duerfen nicht mit GerNetiX-Service-Secrets geteilt werden.
FORGEJO_POSTGRES_PASSWORD=replace-with-a-unique-forgejo-database-password
FORGEJO_SECRET_KEY=replace-with-a-unique-persistent-forgejo-secret-key
FORGEJO_INTERNAL_TOKEN=replace-with-a-unique-forgejo-internal-token
# Getrennte Forgejo-API-/Git-Tokens fuer den Project Server. Der Provision-Token
# darf Organisationen und private Repositories anlegen; der Runtime-Token liest
# geschuetzte Quellen und schreibt ausschliesslich gebundene Projekt-Repositories.
PROJECT_REPOSITORY_STORE=sql
PROJECT_REQUIRE_FORGEJO_NEW_PROJECTS=false
FORGEJO_PROVISION_TOKEN=replace-with-a-dedicated-forgejo-provision-token
FORGEJO_RUNTIME_TOKEN=replace-with-a-dedicated-forgejo-runtime-token
# Getrenntes Read-Token zwischen Admin Tool und Project Server.
# Diese Commit-IDs liefert tools/publish-forgejo-system-repositories.js --apply.
# Ohne feste 40-stellige Commit-ID startet der Forgejo-Cutover absichtlich nicht.
FORGEJO_ESP32_BASIS_COMMIT=replace-with-40-character-commit-sha
FORGEJO_ESP8266_BASIS_COMMIT=replace-with-40-character-commit-sha
FORGEJO_NEXI_COMMIT=replace-with-40-character-commit-sha
FORGEJO_FLASHBOX_COMMIT=replace-with-40-character-commit-sha
FORGEJO_GAME_COLLECTION_COMMIT=replace-with-40-character-commit-sha
# Standardmaessig bleibt PostgreSQL auf Loopback. Fuer externe Build-Worker hier
# ausschliesslich die private WireGuard-Adresse des VPS eintragen.
RUNTIME_POSTGRES_BIND_ADDRESS=127.0.0.1
RUNTIME_POSTGRES_HOST_PORT=25432
# Bevorzugte Worker werden immer vor dem VPS-Worker verwendet. Fuer den Mac:
# 10.77.0.5:4400. Mehrere gleich schnelle Primaer-Worker werden mit least_conn verteilt.
BUILD_WORKER_PRIMARY_UPSTREAMS=
BUILD_ROUTER_REMOTE_DEV_PORT=14400
# Optionale weitere Worker-Endpunkte im WireGuard-Netz. Sobald mindestens ein
# Primaer-Worker konfiguriert ist, bilden diese zusammen mit dem VPS den Rueckfallpool.
BUILD_WORKER_UPSTREAMS=
# Eigenes, langes Passwort fuer den technisch eingeschraenkten PostgreSQL-Login
# gernetix_build_worker. Leer lassen, solange kein externer Worker verwendet wird.
BUILD_WORKER_POSTGRES_PASSWORD=
# Providerneutrale Compute-Steuerung. Drei voneinander getrennte, lange Zufallswerte.
# Standardmaessig ist das Worker Gateway nur auf Loopback gebunden. Fuer private
# Rechner ausschliesslich eine WireGuard-Adresse wie 10.77.0.1 verwenden.
COMPUTE_BIND_ADDRESS=127.0.0.1
COMPUTE_PORT=5700
COMPUTE_WORKER_BOOTSTRAP_TOKEN=replace-with-a-separate-long-random-secret
COMPUTE_WORKER_SIGNING_SECRET=replace-with-a-separate-long-random-secret
COMPUTE_PROJECT_GRANT_SIGNING_SECRET=replace-with-a-separate-long-random-secret
COMPUTE_WORKER_TOKEN_TTL_SECONDS=900
COMPUTE_LEASE_TTL_MS=60000
BUILD_ARTIFACT_UPLOAD_TOKEN=replace-with-a-separate-long-random-secret
# Separater Base64-kodierter 32-Byte-Schluessel fuer verschluesselte Runtime-Konfiguration.
RUNTIME_STATE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
AI_CONTEXT_EMBEDDING_PROVIDER=openai
AI_CONTEXT_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_CONTEXT_EMBEDDING_MODEL=text-embedding-3-small
AI_CONTEXT_EMBEDDING_DIMENSIONS=768
AI_CONTEXT_OPENAI_API_KEY=
