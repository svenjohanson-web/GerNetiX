# Stabile, pro Rechner eindeutige Kennung. Nur Kleinbuchstaben, Zahlen, Punkt, Minus und Unterstrich.
BUILD_WORKER_ID=build-worker-01

# Ausschliesslich die private WireGuard-Adresse dieses Linux-, macOS- oder Windows-Rechners verwenden.
# Niemals 0.0.0.0 oder eine oeffentliche Adresse eintragen.
BUILD_WORKER_BIND_ADDRESS=10.77.0.20
BUILD_WORKER_PORT=4400
BUILD_CANCELLATION_POLL_MS=500

# PostgreSQL des GerNetiX-VPS ueber WireGuard.
BUILD_POSTGRES_HOST=10.77.0.1
BUILD_POSTGRES_PORT=25432
BUILD_POSTGRES_DATABASE=gernetix_runtime
BUILD_POSTGRES_USER=gernetix_build_worker
BUILD_POSTGRES_PASSWORD=replace-with-dedicated-build-worker-password

# Kanonischer Download-Endpunkt; der Worker selbst wird nicht oeffentlich bereitgestellt.
BUILD_PUBLIC_BASE_URL=https://build.gernetix.com
GERNETIX_BUILD_WORKER_IMAGE_TAG=local
